---
import { Image } from 'astro:assets';

import img1 from '../assets/banner-beaver-v2.webp';
import img2 from '../assets/banner-hero-v2.webp';
import img3 from '../assets/banner-zeus-v2.webp';
---

<section id="features" class="relative bg-white dark:bg-neutral-900 py-16 md:py-32">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    
    <div class="flex flex-col md:flex-row gap-12 lg:gap-24 items-start relative">
      
      <div class="w-full md:w-1/2 md:py-12">
        
        <div class="feature-block flex flex-col justify-center min-h-[50vh] md:min-h-[60vh]" data-index="0">
          <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-neutral-900 dark:text-white mb-6 tracking-tight">Design Absurdo</h3>
          <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed">A sua primeira impressão importa. Nós criamos layouts que convertem curiosos em compradores na mesma hora.</p>
          
          <div class="block md:hidden w-full mt-10 rounded-3xl overflow-hidden shadow-2xl">
             <Image src={img1} alt="Design Absurdo" class="w-full h-auto object-cover" />
          </div>
        </div>

        <div class="feature-block flex flex-col justify-center min-h-[50vh] md:min-h-[60vh]" data-index="1">
          <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-neutral-900 dark:text-white mb-6 tracking-tight">Velocidade Extrema</h3>
          <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed">Sem travamentos. A imagem ao lado acabou de mudar enquanto você lia isso, e o site continua marcando 100 no Lighthouse.</p>
          
          <div class="block md:hidden w-full mt-10 rounded-3xl overflow-hidden shadow-2xl">
             <Image src={img2} alt="Velocidade Extrema" class="w-full h-auto object-cover" />
          </div>
        </div>

        <div class="feature-block flex flex-col justify-center min-h-[50vh] md:min-h-[60vh]" data-index="2">
          <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-neutral-900 dark:text-white mb-6 tracking-tight">Fácil de Editar</h3>
          <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed">Só trocar o texto e a foto. Sem dores de cabeça com vídeos pesados ou animações complexas.</p>
          
          <div class="block md:hidden w-full mt-10 rounded-3xl overflow-hidden shadow-2xl">
             <Image src={img3} alt="Fácil de Editar" class="w-full h-auto object-cover" />
          </div>
        </div>

      </div>

      <div class="hidden md:block w-1/2 sticky top-24 h-150 max-h-[80vh] rounded-[2rem] overflow-hidden shadow-2xl bg-neutral-950 border border-neutral-800 relative">
        
        <div class="feature-img absolute inset-0 transition-opacity duration-700 ease-in-out opacity-100" data-image="0">
          <Image src={img1} alt="Feature 1" class="w-full h-full object-cover" />
        </div>
        
        <div class="feature-img absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0" data-image="1">
          <Image src={img2} alt="Feature 2" class="w-full h-full object-cover" />
        </div>
        
        <div class="feature-img absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0" data-image="2">
          <Image src={img3} alt="Feature 3" class="w-full h-full object-cover" />
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const initScrollSwap = () => {
    if (window.innerWidth < 768) return;

    const blocks = document.querySelectorAll('.feature-block');
    const images = document.querySelectorAll('.feature-img');

    if (!blocks.length || !images.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const index = entry.target.getAttribute('data-index');
          
          images.forEach(img => {
            img.classList.remove('opacity-100');
            img.classList.add('opacity-0');
          });
          
          const activeImg = document.querySelector(`.feature-img[data-image="${index}"]`);
          if (activeImg) {
            activeImg.classList.remove('opacity-0');
            activeImg.classList.add('opacity-100');
          }
        }
      });
    }, {
      // Ajustei para 30% para o disparo ser mais suave
      rootMargin: "-30% 0px -30% 0px",
      threshold: 0.1
    });

    blocks.forEach(block => observer.observe(block));
  };

  // Garante que o script roda no carregamento normal
  document.addEventListener('DOMContentLoaded', initScrollSwap);
  // Garante que o script roda se você usar as transições nativas do Astro
  document.addEventListener('astro:page-load', initScrollSwap);
</script>