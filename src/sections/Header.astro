---
// Sem importações de React aqui! 100% nativo.
---

<header class="fixed top-0 w-full z-50 bg-white/80 dark:bg-neutral-950/80 backdrop-blur-md border-b border-neutral-200 dark:border-neutral-800 transition-colors duration-300">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl h-20 flex items-center justify-between">
    
    <a href="/" class="text-2xl font-bold text-neutral-900 dark:text-white tracking-tight">
      Sua<span class="text-primary-600">Agência</span>.
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      
      <nav class="hidden md:flex gap-6">
        <a href="#features" class="text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-500 transition-colors">Benefícios</a>
        <a href="#faq" class="text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-500 transition-colors">FAQ</a>
      </nav>
      
      <button 
        id="theme-toggle-btn" 
        aria-label="Alternar tema"
        class="p-2.5 rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors cursor-pointer"
      >
        <svg class="w-5 h-5 hidden dark:block pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="w-5 h-5 block dark:hidden pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a href="#contact" class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-primary-600 hover:bg-primary-700 rounded-lg transition-colors shadow-sm">
        Falar com Especialista
      </a>
      
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle-btn');
  
  btn?.addEventListener('click', (event) => {
    const html = document.documentElement;
    const isDark = html.classList.contains('dark');
    const newTheme = isDark ? 'light' : 'dark';

    // Se o navegador for antigo, troca normal sem travar
    if (!document.startViewTransition) {
      html.classList.toggle('dark');
      localStorage.setItem('theme', newTheme);
      return;
    }

    // Pega o ponto de clique
    const x = event.clientX;
    const y = event.clientY;
    
    // Calcula o tamanho da tela para a onda cobrir tudo
    const endRadius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y)
    );

    // Inicia a transição
    const transition = document.startViewTransition(() => {
      html.classList.toggle('dark');
      localStorage.setItem('theme', newTheme);
    });

    // Faz a mágica da onda na NOVA tela que está por cima
    transition.ready.then(() => {
      html.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`
          ],
        },
        {
          duration: 700,
          easing: 'ease-out',
          pseudoElement: '::view-transition-new(root)',
        }
      );
    });
  });
</script>
